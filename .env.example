# ---- Copy to .env and fill in. NEVER commit .env ----
NODE_ENV=development
PORT=3000
# Public URL used inside password-reset links
APP_URL=http://localhost:3000

# SQLite database file (created automatically)
DB_FILE=./data/repairstop.db
UPLOAD_DIR=./data/uploads

# ---- SMTP (optional; used for password-reset and notification emails) ----
# Gmail example: host smtp.gmail.com, port 587, SMTP_SECURE=false (STARTTLS),
# user = your address, pass = a Google "App password" (not your login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RepairStop <no-reply@yourdomain.com>"

# ---- Admin bootstrap (optional; or run `npm run create-admin`) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- Payments: Razorpay TEST mode keys (https://dashboard.razorpay.com) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Shown in the footer (optional) ----
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Set true ONLY when running behind a reverse proxy (nginx, Caddy, Render...) that sets X-Forwarded-For
TRUST_PROXY=false
